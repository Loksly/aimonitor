{
  "name": "@loksly/aimonitor",
  "version": "1.1.0",
  "description": "Dashboard de sesiones de Claude Code y Gemini para el panel LCD USB Thermalright Trofeo Vision",
  "main": "dist/src/render.js",
  "bin": {
    "aimonitor-hook": "./dist/src/hook.js",
    "aimonitor-daemon": "./dist/src/daemon.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Loksly/aimonitor.git"
  },
  "bugs": {
    "url": "https://github.com/Loksly/aimonitor/issues"
  },
  "homepage": "https://github.com/Loksly/aimonitor#readme",
  "files": [
    "99-trcc.rules",
    "LICENSE",
    "README.md",
    "aimonitor.service",
    "dist",
    "docs",
    "trcc-serve.service"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/src/hook.js dist/src/daemon.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --experimental-test-coverage src/**/*.test.ts",
    "preview": "node --experimental-strip-types src/preview.ts",
    "gallery": "node --experimental-strip-types src/gallery.ts",
    "simulate": "node scripts/simulate.js",
    "prepublishOnly": "npm run build",
    "docs": "node --experimental-strip-types src/docs.ts",
    "pages": "npm run preview -- --all --out preview && npm run docs && npm run gallery"
  },
  "keywords": [
    "claude",
    "claude-code",
    "gemini",
    "lcd",
    "thermalright",
    "trcc",
    "dashboard",
    "monitor"
  ],
  "author": "Loksly",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "marked": "^18.0.9",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
