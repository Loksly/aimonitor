{
  "//": "Guardar este archivo en ~/.aimonitor/config.json para personalizar la configuración",
  
  "rail": {
    "enabled": true,
    "width": 356
  },
  
  "tile": {
    "min": 320,
    "max": 430,
    "gap": 12
  },
  
  "margin": 14,
  "headerHeight": 60,
  "spineWidth": 7,
  
  "pixelShift": {
    "enabled": true,
    "amplitude": 2,
    "periodMs": 480000
  },
  
  "zombieMs": 900000,
  
  "usage": {
    "//mode": "'max' pinta ventanas de 5 h y semana; 'api' pinta gasto en USD contra los topes de abajo",
    "mode": "max",
    "bin": "ccusage",
    "refreshMs": 120000,

    "//calibration": "Solo en modo max. ccusage no expone el límite del plan, así que el 100% de las barras se calibra contra tu propio histórico: metric 'cost' usa el coste equivalente, percentile 100 = tu bloque más cargado de los últimos lookbackDays. Bájalo a 90 si las barras se quedan siempre pegadas al suelo.",
    "calibration": {
      "metric": "cost",
      "lookbackDays": 30,
      "percentile": 100
    },

    "//caps": "Solo en modo api, en USD",
    "dailyCap": 15.0,
    "monthlyCap": 300.0
  },

  "thresholds": {
    "warn": 0.6,
    "alert": 0.85
  },

  "//system": "Columna de vitales que rellena el hueco cuando hay pocas casillas (1088 px sobran con una sola sesión). Con 4 o más desaparece sola. Sus umbrales son más altos que los del consumo a propósito: una RAM al 70% es normal, y con 0.6 la columna viviría encendida compitiendo con las consolas que sí reclaman.",
  "system": {
    "enabled": true,
    "minWidth": 190,
    "perCoreMinWidth": 700,
    "diskPath": "/",
    "warn": 0.85,
    "alert": 0.95,
    "tempWarn": 85,
    "tempAlert": 95
  },

  "trcc": {
    "//": "La salida va por la API REST de `trcc serve`, no por la CLI: el USB es exclusivo y un solo proceso debe poseerlo. deviceKey vacío = coger el primer panel que reporte el servidor.",
    "bin": "trcc",
    "deviceKey": "",
    "extraArgs": [],
    "//api": "Dónde escucha `trcc serve`. Sólo loopback: la API no lleva autenticación.",
    "api": { "url": "http://127.0.0.1:8099" },
    "timeoutMs": 20000,
    "//keepalive": "El firmware LY descarta la imagen a los ~2-3 s sin frame. burstS acota cada ráfaga: si se pidiera un bucle sin fin, sobreviviría a la muerte del daemon y dejaría al servidor bloqueado para todo lo demás.",
    "keepalive": { "enabled": true, "intervalS": 0.15, "burstS": 30 }
  },
  
  "blankWhenIdle": true,
  
  "fonts": {
    "condensedBold": "/usr/share/fonts/truetype/dejavu/DejaVuSansCondensed-Bold.ttf",
    "mono": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
    "monoBold": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono-Bold.ttf"
  }
}
